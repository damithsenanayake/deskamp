{
  "name": "deskamp",
  "productName": "DeskAmp",
  "version": "0.3.0",
  "private": true,
  "description": "A compact desktop music player for macOS and Linux",
  "author": "DeskAmp contributors",
  "desktopName": "DeskAmp",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/docking.js && node --check scripts/generate-icon.js",
    "test": "node --test tests/*.test.js",
    "icon": "node scripts/generate-icon.js",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:intel": "electron-builder --mac dmg zip --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage --arm64",
    "dist": "electron-builder --mac --linux"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.deskamp.player",
    "productName": "DeskAmp",
    "directories": { "output": "release" },
    "files": ["src/**/*", "build/icon.png", "package.json", "README.md"],
    "mac": { "category": "public.app-category.music", "icon": "build/icon.png", "target": ["dmg", "zip"] },
    "linux": { "category": "AudioVideo", "icon": "build/icon.png", "syncDesktopName": true, "target": ["AppImage"] }
  }
}
